{
  "meta": {
    "title": "Labor",
    "subtitle": "The time study, as structured data",
    "source": "Built by walking a normal farm day in voice, 26 August 2026",
    "basis": "These are James' estimates from a season of doing the work rather than stopwatch measurements, and they are recorded at the precision they were given.",
    "conventions": [
      "Durations are recorded per unit, with the counts held separately. A change in count then re-costs the day without anyone measuring it again.",
      "Fixed per-visit overhead is recorded apart, because it does not scale with unit count and gets cheaper per bird as the farm grows.",
      "Overlap is recorded per task. Time that runs alongside other work is real, and adding it to the total would say the day is longer than it is.",
      "*Who* is recorded as shared, Jim, or James. Nearly everything is shared, because there are no assigned chore blocks and work falls to whoever is present."
    ],
    "nav": {
      "prev": { "text": "Measures", "link": "/measures/" },
      "next": { "text": "Goods", "link": "/measures/goods" }
    },
    "units": {
      "tractor": { "label": "Salatin tractor", "birds": 60, "default": 5, "pasture": true },
      "coop600": { "label": "Model 600", "birds": 900, "default": 0, "pasture": true },
      "layerCoop": { "label": "Layer coop", "default": 2 },
      "brooder": { "label": "Brooder", "birds": 900, "default": 1 }
    },
    "enterprises": {
      "broiler": "Broilers",
      "layer": "Layers",
      "shared": "Neither"
    },
    "week": { "weekdays": 5, "weekend": 2 }
  },

